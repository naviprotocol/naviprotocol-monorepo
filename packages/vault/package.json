{
  "name": "@naviprotocol/vault",
  "version": "0.0.1-beta.2",
  "description": "Unified Lending and Volo Vault SDK",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "navi",
    "vault",
    "sui"
  ],
  "author": "NAVI",
  "bugs": "https://github.com/naviprotocol/naviprotocol-monorepo/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/naviprotocol/naviprotocol-monorepo.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "run-p build:lib",
    "build:lib": "vite build",
    "prettier": "prettier --check src/ tests/",
    "prettier:fix": "prettier --write src/ tests/",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "verify": "run-p prettier lint",
    "verify:fix": "run-p prettier:fix lint:fix",
    "test": "vitest --config ./vite.config.unit.js",
    "test:mainnet": "NAVI_LIVE_TESTS=1 vitest --config ./vite.config.unit.js --run tests/mainnet/mainnet.test.ts",
    "test:mainnet:report": "NAVI_LIVE_TESTS=1 VAULT_TEST_REPORT=1 vitest --config ./vite.config.unit.js --run tests/mainnet/mainnet.test.ts",
    "test:types": "pnpm build:lib && tsc --noEmit -p tsconfig.type-tests.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typedoc": "typedoc"
  },
  "devDependencies": {
    "@mysten/sui": "2.20.2",
    "@types/node": "22.7.5",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "@mysten/sui": ">=2.0.0"
  },
  "dependencies": {
    "@naviprotocol/lending": "workspace:^"
  }
}
